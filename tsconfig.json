{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
